{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm build",
      "icon": { "id": "tools" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      "detail": "Vite lib build (ESM + CJS + .d.ts).",
      "options": { "statusbar": { "color": "#22C1D6", "label": "Build" } }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "pnpm lint",
      "icon": { "id": "search-fuzzy" },
      "group": "test",
      "problemMatcher": ["$eslint-stylish"],
      "detail": "Prettier check + ESLint.",
      "options": { "statusbar": { "color": "#22C1D6", "label": "Lint" } }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "pnpm test",
      "icon": { "id": "beaker" },
      "group": { "kind": "test", "isDefault": true },
      "detail": "Run tests with Vitest.",
      "options": { "statusbar": { "color": "#22d682", "label": "Test" } }
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "pnpm run type-check",
      "icon": { "id": "type-hierarchy" },
      "group": "test",
      "problemMatcher": ["$tsc"],
      "detail": "TypeScript type checking (tsc --noEmit).",
      "options": { "statusbar": { "color": "#22d682", "label": "TS" } }
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "pnpm lint-fix",
      "icon": { "id": "git-compare" },
      "group": "build",
      "detail": "Prettier write + ESLint --fix.",
      "options": { "statusbar": { "color": "#ca9b3d", "label": "Format" } }
    },
    {
      "label": "Storybook",
      "type": "shell",
      "command": "pnpm storybook",
      "isBackground": true,
      "icon": { "id": "notebook" },
      "group": "build",
      "detail": "Storybook dev server (the demo).",
      "options": { "statusbar": { "color": "#cf6eff", "label": "Storybook" } }
    }
  ]
}
