{
  "name": "image-cache-pro-react",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "React bindings for image-cache-pro — providers and hooks to stage image decode/GPU work off the interaction critical path on resource-constrained devices (STB/Cobalt, low-power TVs).",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "license": "MIT",
  "author": {
    "name": "Samvel Avanesov",
    "email": "sam.avanesoff@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savanesoff/image-cache-pro-react"
  },
  "packageManager": "pnpm@9.1.4",
  "keywords": [
    "image cache",
    "react",
    "react hooks",
    "image loading",
    "image pre-rendering",
    "RAM management",
    "GPU management",
    "web performance",
    "cobalt",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.1.4"
  },
  "bugs": {
    "url": "https://github.com/savanesoff/image-cache-pro-react/issues"
  },
  "homepage": "https://github.com/savanesoff/image-cache-pro-react#readme",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "clean": "rm -rf ./dist",
    "build:types": "tspc --project tsconfig.package.json",
    "build": "pnpm run clean && vite build && pnpm run build:types",
    "prepack": "pnpm run build",
    "release": "pnpm run build && pnpm run test && pnpm changeset publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "image-cache-pro": "^0.6.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-patch": "^3.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "typescript-transform-paths": "^3.5.5",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  }
}
